{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "defaults",
            "hidden": true,
            "binaryDir": "${sourceDir}/.build/${presetName}",
            "installDir": "${sourceDir}/.install/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "On",
                "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo;Release"
            }
        },
        {
            "name": "host-system",
            "displayName": "Host build (system dependencies)",
            "description": "Build using system dependencies.",
            "inherits": "defaults",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CCR_FETCH_DEPS": "Off",
                "CCR_BUILD_TESTS": "Off",
                "CCR_BUILD_EXAMPLES": "Off",
                "CCR_ENABLE_SANITIZERS": "Off"
            }
        },
        {
            "name": "host-fetch-deps",
            "displayName": "Host build (fetch dependencies)",
            "description": "Build using fetched dependencies.",
            "inherits": "defaults",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CCR_FETCH_DEPS": "On",
                "CCR_BUILD_TESTS": "Off",
                "CCR_BUILD_EXAMPLES": "Off",
                "CCR_ENABLE_SANITIZERS": "Off"
            }
        },
        {
            "name": "test-system",
            "displayName": "Test build (system dependencies)",
            "description": "Build with unit tests and sanitizers enabled using system dependencies. Used by CI to build and run the test suite.",
            "inherits": "defaults",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CCR_FETCH_DEPS": "Off",
                "CCR_BUILD_TESTS": "On",
                "CCR_BUILD_EXAMPLES": "On",
                "CCR_ENABLE_SANITIZERS": "On"
            }
        },
        {
            "name": "test-fetch-deps",
            "displayName": "Test build (fetch dependencies)",
            "description": "Build with unit tests and sanitizers enabled using fetched dependencies. Used by CI to build and run the test suite.",
            "inherits": "defaults",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CCR_FETCH_DEPS": "On",
                "CCR_BUILD_TESTS": "On",
                "CCR_BUILD_EXAMPLES": "On",
                "CCR_ENABLE_SANITIZERS": "On"
            }
        },
        {
            "name": "coverage",
            "inherits": "defaults",
            "description": "Build with unit tests and coverage enabled using fetched dependencies. Used by CI to build and run the test suite.",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CCR_FETCH_DEPS": "Off",
                "CCR_BUILD_TESTS": "On",
                "CCR_BUILD_EXAMPLES": "Off",
                "CCR_ENABLE_COVERAGE": "On"
            }
        },
        {
            "name": "host-system-time-profile",
            "displayName": "Configuration time profiling",
            "inherits": "defaults",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CCR_ENABLE_TIME_PROFILE": "On"
            }
        },
        {
            "name": "windows-clang-cl",
            "inherits": "defaults",
            "toolchainFile": "${sourceDir}/cmake/toolchain-clang-x86_64-pc-windows-msvc.cmake",
            "environment": {
                "CCACHE_DEPEND": "true",
                "CCACHE_COMPILERTYPE": "clang-cl"
            },
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "CCR_FETCH_DEPS": "On",
                "CCR_BUILD_TESTS": "Off",
                "CCR_BUILD_EXAMPLES": "Off",
                "CCR_ENABLE_SANITIZERS": "Off"
            }
        },
        {
            "name": "windows-clang-cl-test",
            "displayName": "Windows cross test build (clang-cl + wine)",
            "description": "Cross-compile with tests enabled; tests run through wine. Requires the Windows SDK in /winsdk (see get-winsdk.sh).",
            "inherits": "windows-clang-cl",
            "cacheVariables": {
                "CCR_BUILD_TESTS": "On"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host-system",
            "configurePreset": "host-system"
        },
        {
            "name": "host-fetch-deps",
            "configurePreset": "host-fetch-deps"
        },
        {
            "name": "test-system",
            "configurePreset": "test-system"
        },
        {
            "name": "test-fetch-deps",
            "configurePreset": "test-fetch-deps"
        },
        {
            "name": "coverage",
            "configurePreset": "coverage"
        },
        {
            "name": "coverage-report",
            "configurePreset": "coverage",
            "targets": [
                "generate-lcov-report"
            ]
        },
        {
            "name": "host-system-time-profile",
            "configurePreset": "host-system-time-profile"
        },
        {
            "name": "windows-clang-cl",
            "configurePreset": "windows-clang-cl",
            "configuration": "Debug"
        },
        {
            "name": "windows-clang-cl-test",
            "configurePreset": "windows-clang-cl-test",
            "configuration": "RelWithDebInfo"
        }
    ],
    "testPresets": [
        {
            "name": "defaults",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        },
        {
            "name": "test-system",
            "configurePreset": "test-system",
            "inherits": "defaults"
        },
        {
            "name": "test-fetch-deps",
            "configurePreset": "test-fetch-deps",
            "inherits": "defaults"
        },
        {
            "name": "coverage",
            "configurePreset": "coverage",
            "inherits": "defaults"
        },
        {
            "name": "windows-clang-cl-test",
            "configurePreset": "windows-clang-cl-test",
            "configuration": "RelWithDebInfo",
            "inherits": "defaults",
            "environment": {
                "WINEDEBUG": "-all"
            },
            "filter": {
                "exclude": {
                    "name": "^(acceptance\\.test|cucumber_cpp\\.acceptance_test\\.bats)$"
                }
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "host-system",
            "steps": [
                {
                    "type": "configure",
                    "name": "host-system"
                },
                {
                    "type": "build",
                    "name": "host-system"
                }
            ]
        },
        {
            "name": "host-fetch-deps",
            "steps": [
                {
                    "type": "configure",
                    "name": "host-fetch-deps"
                },
                {
                    "type": "build",
                    "name": "host-fetch-deps"
                }
            ]
        },
        {
            "name": "test-system",
            "steps": [
                {
                    "type": "configure",
                    "name": "test-system"
                },
                {
                    "type": "build",
                    "name": "test-system"
                },
                {
                    "type": "test",
                    "name": "test-system"
                }
            ]
        },
        {
            "name": "test-fetch-deps",
            "steps": [
                {
                    "type": "configure",
                    "name": "test-fetch-deps"
                },
                {
                    "type": "build",
                    "name": "test-fetch-deps"
                },
                {
                    "type": "test",
                    "name": "test-fetch-deps"
                }
            ]
        },
        {
            "name": "coverage",
            "steps": [
                {
                    "type": "configure",
                    "name": "coverage"
                },
                {
                    "type": "build",
                    "name": "coverage"
                },
                {
                    "type": "test",
                    "name": "coverage"
                },
                {
                    "type": "build",
                    "name": "coverage-report"
                }
            ]
        },
        {
            "name": "host-system-time-profile",
            "steps": [
                {
                    "type": "configure",
                    "name": "host-system-time-profile"
                },
                {
                    "type": "build",
                    "name": "host-system-time-profile"
                }
            ]
        },
        {
            "name": "windows-clang-cl",
            "steps": [
                {
                    "type": "configure",
                    "name": "windows-clang-cl"
                },
                {
                    "type": "build",
                    "name": "windows-clang-cl"
                }
            ]
        }
    ]
}
